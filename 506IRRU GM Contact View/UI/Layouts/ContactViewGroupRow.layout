ButtonWidgetClass {
 Name "GroupRowButton"
 Slot AlignableSlot "{IRRU_CVGroupRow002}" {
  HorizontalAlign 3
  VerticalAlign 0
 }
 Clipping False
 Color 1 1 1 0
 components {
  SCR_ButtonBaseComponent "{IRRU_CVGroupRow003}" {
   m_bMouseOverToFocus 1
   m_BackgroundDefault 0.1 0.1 0.1 0.9
   m_BackgroundHovered 0.15 0.15 0.15 0.95
   m_BackgroundSelected 0.2 0.2 0.2 1
   m_BackgroundSelectedHovered 0.25 0.25 0.25 1
   m_BackgroundClicked 0.2 0.2 0.2 1
  }
 }
 {
  SizeLayoutWidgetClass "{IRRU_CVGroupRow004}" {
   Name "SizeLayout"
   Slot ButtonWidgetSlot "{IRRU_CVGroupRow005}" {
    HorizontalAlign 3
   }
   AllowHeightOverride 1
   HeightOverride 32
   {
    OverlayWidgetClass "{IRRU_CVGroupRow006}" {
     Name "Overlay"
     Slot ButtonWidgetSlot "{IRRU_CVGroupRow007}" {
      HorizontalAlign 3
      VerticalAlign 3
      Padding 4 2 4 2
     }
     {
      ImageWidgetClass "{IRRU_CVGroupRow008}" {
       Name "Background"
       Slot OverlayWidgetSlot "{IRRU_CVGroupRow009}" {
        HorizontalAlign 3
        VerticalAlign 3
       }
       Color 0.1 0.1 0.1 0.8
      }
      HorizontalLayoutWidgetClass "{IRRU_CVGroupRow010}" {
       Name "HorizontalLayout"
       Slot OverlayWidgetSlot "{IRRU_CVGroupRow011}" {
        HorizontalAlign 3
        VerticalAlign 3
       }
       {
        TextWidgetClass "{IRRU_CVGroupRow012}" {
         Name "ExpandIcon"
         Slot LayoutSlot "{IRRU_CVGroupRow013}" {
          VerticalAlign 1
          Padding 4 0 8 0
         }
         Color 1 1 1 1
         Text ">"
         "Font Size" 14
        }
        TextWidgetClass "{IRRU_CVGroupRow014}" {
         Name "StatusIcon"
         Slot LayoutSlot "{IRRU_CVGroupRow015}" {
          VerticalAlign 1
          Padding 0 0 8 0
         }
         Color 0 1 0 1
         Text "OK"
         "Font Size" 12
        }
        SizeLayoutWidgetClass "{IRRU_CVGroupRow016}" {
         Name "NameLayout"
         Slot LayoutSlot "{IRRU_CVGroupRow017}" {
          VerticalAlign 1
          SizeMode Fill
          FillWeight 3
         }
         {
          TextWidgetClass "{IRRU_CVGroupRow018}" {
           Name "GroupName"
           Slot LayoutSlot "{IRRU_CVGroupRow019}" {
            VerticalAlign 1
           }
           Color 1 1 1 1
           Text "Alpha 1"
           "Font Size" 14
          }
         }
        }
        TextWidgetClass "{IRRU_CVGroupRow020}" {
         Name "PlayerCount"
         Slot LayoutSlot "{IRRU_CVGroupRow021}" {
          VerticalAlign 1
          Padding 8 0 8 0
         }
         Color 0.7 0.7 0.7 1
         Text "(4)"
         "Font Size" 12
        }
        SizeLayoutWidgetClass "{IRRU_CVGroupRow022}" {
         Name "TimeLayout"
         Slot LayoutSlot "{IRRU_CVGroupRow023}" {
          VerticalAlign 1
         }
         AllowMinDesiredWidth 1
         MinDesiredWidth 50
         {
          TextWidgetClass "{IRRU_CVGroupRow024}" {
           Name "TimeText"
           Slot LayoutSlot "{IRRU_CVGroupRow025}" {
            HorizontalAlign 2
            VerticalAlign 1
           }
           Color 1 1 1 1
           Text "5:30"
           "Font Size" 14
          }
         }
        }
       }
      }
     }
    }
   }
  }
 }
}